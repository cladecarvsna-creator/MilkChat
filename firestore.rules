rules_version = '2';

// Правила Firestore для MilkChat. Структура данных описана в
// lib/data/firebase_repository.dart. Публикация: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Роль модератора выдаёт только сервер (Custom Claims через tool/admin).
    function isStaff() { return signedIn() && request.auth.token.staff == true; }
    // Заблокированный модератором пользователь не может писать и создавать чаты.
    function notBanned() {
      return !get(/databases/$(database)/documents/users/$(uid())).data.get('banned', false);
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── Профили ───────────────────────────────────────────────────────────
    // Профиль публичный (имя, юзернейм, аватар). Почта в нём не хранится.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == userId
        && request.resource.data.verified == false
        && request.resource.data.get('banned', false) == false
        && request.resource.data.username is string
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,32}$');
      // verified меняет только Admin SDK — клиенту поле недоступно.
      allow update: if signedIn() && uid() == userId
        && !changed().hasAny(['verified', 'banned', 'createdAt'])
        && (!('username' in changed())
            || (request.resource.data.username.matches('^[A-Za-z0-9_]{3,32}$')
                && request.resource.data.usernameLower == request.resource.data.username.lower()));
      // Модератор (claim staff) выдаёт галочку и блокирует — и только эти поля.
      allow update: if isStaff() && changed().hasOnly(['verified', 'banned']);
      allow delete: if false;
    }

    // Уникальные юзы: {uid} у людей или {chatId} у каналов — одно пространство имён.
    // Занять можно только свободный: на себя или на канал, где ты админ.
    match /usernames/{name} {
      function channelAdmin(chatId) {
        let c = get(/databases/$(database)/documents/chats/$(chatId)).data;
        return c.kind == 'channel' && uid() in c.admins;
      }
      allow read: if true;
      allow create: if signedIn() && (
        (request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid())
        || (request.resource.data.keys().hasOnly(['chatId'])
            && name.matches('^[a-z0-9_]{3,32}$')
            && channelAdmin(request.resource.data.chatId)));
      allow delete: if signedIn() && (
        resource.data.get('uid', '') == uid()
        || (resource.data.get('chatId', '') != '' && channelAdmin(resource.data.chatId)));
      allow update: if false;
    }

    // Личные настройки чатов (закреп, звук, архив) — только владелец.
    match /user_settings/{userId}/chats/{chatId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ─── Чаты, группы, каналы ──────────────────────────────────────────────
    match /chats/{chatId} {
      function data() { return resource.data; }
      function isMember() { return signedIn() && uid() in data().members; }
      function isAdmin() { return signedIn() && uid() in data().admins; }
      // Поля, которые обновляет любой участник при отправке и чтении.
      function activityOnly() {
        return changed().hasOnly(['lastMessage', 'lastAt', 'unread', 'readAt']);
      }

      // Канал с юзом публичный: его видит любой вошедший пользователь.
      function isPublic() { return data().kind == 'channel' && data().get('handle', null) != null; }

      // Несуществующий документ можно «прочитать» — так клиент проверяет,
      // есть ли уже личный чат.
      allow get: if signedIn() && (resource == null || isMember() || isStaff() || isPublic());
      allow list: if isStaff() || (signedIn() && uid() in resource.data.members);

      allow create: if signedIn() && notBanned()
        && request.resource.data.createdBy == uid()
        && uid() in request.resource.data.members
        && (
          // Личный чат: ровно двое, id = dm_<uid1>_<uid2>, без админов.
          (request.resource.data.kind == 'direct'
            && request.resource.data.members.size() == 2
            && request.resource.data.admins.size() == 0
            && chatId == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1])
          ||
          // Группа/канал: создатель — единственный админ.
          (request.resource.data.kind in ['group', 'channel']
            && request.resource.data.admins == [uid()]
            && !('handle' in request.resource.data)
            && chatId != 'milkchat')
        );

      // Юз ставится только вместе с записью usernames/{юз} = {chatId}.
      function handleValid() {
        return !changed().hasAny(['handle', 'handleLower'])
          || (request.resource.data.get('handle', null) == null
              && request.resource.data.get('handleLower', null) == null)
          || (data().kind == 'channel'
              && request.resource.data.handle.matches('^[A-Za-z0-9_]{3,32}$')
              && request.resource.data.handleLower == request.resource.data.handle.lower()
              && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.handleLower))
                   .data.get('chatId', '') == chatId);
      }

      allow update: if
        // Отправка сообщений и отметки о прочтении.
        (isMember() && activityOnly()
          && (data().kind != 'channel' || isAdmin() || changed().hasOnly(['unread', 'readAt'])))
        // Админ меняет название, описание, юз, участников и админов.
        // Админы — только из участников; создателя канала другие админы не снимают.
        || (isAdmin() && data().kind != 'direct'
          && changed().hasOnly(['title', 'about', 'avatarUrl', 'members', 'admins',
                                'handle', 'handleLower',
                                'lastMessage', 'lastAt', 'unread', 'readAt'])
          && request.resource.data.members.hasAll(request.resource.data.admins)
          && request.resource.data.admins.size() > 0
          && (!(data().get('createdBy', '') in data().admins)
              || data().createdBy in request.resource.data.admins
              || uid() == data().createdBy)
          && handleValid())
        // Подписка на канал: добавить в участники только себя.
        || (signedIn() && data().kind == 'channel'
          && changed().hasOnly(['members'])
          && request.resource.data.members.toSet()
               .difference(data().members.toSet()) == [uid()].toSet())
        // Выход: убрать из участников только себя.
        || (isMember() && changed().hasOnly(['members', 'admins'])
          && data().members.toSet().difference(request.resource.data.members.toSet())
               == [uid()].toSet()
          && request.resource.data.admins.toSet().difference(data().admins.toSet()).size() == 0)
        // Модератор: название, описание, участники, админы, галочка.
        || (isStaff() && changed().hasOnly(['title', 'about', 'avatarUrl', 'members', 'admins',
                                           'verified', 'lastMessage', 'lastAt']));

      allow delete: if isStaff();

      // ─── Сообщения ───────────────────────────────────────────────────────
      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function member() { return signedIn() && uid() in chat().members; }
        function admin() { return signedIn() && uid() in chat().admins; }

        // Сообщения публичного канала читает любой вошедший — как превью до подписки.
        allow read: if member() || isStaff()
          || (signedIn() && chat().kind == 'channel' && chat().get('handle', null) != null);
        allow create: if member() && notBanned()
          && (chat().kind != 'channel' || admin())
          && request.resource.data.senderId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4096
          && request.resource.data.createdAt == request.time
          // Ответ и пересылка — необязательные поля.
          && (!('replyTo' in request.resource.data) || request.resource.data.replyTo is map)
          && (!('forwardedFrom' in request.resource.data)
              || (request.resource.data.forwardedFrom is string
                  && request.resource.data.forwardedFrom.size() <= 100));
        // Редактирует только автор, и только текст.
        allow update: if member() && resource.data.senderId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4096;
        // Удаляет автор, админ группы/канала или модератор.
        allow delete: if (member() && (resource.data.senderId == uid() || admin())) || isStaff();
      }
    }

    // ─── Жалобы ───────────────────────────────────────────────────────────
    // Пользователь может отправить жалобу; читают только модераторы.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid();
      allow read, update, delete: if isStaff();
    }
  }
}
