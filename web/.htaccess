# MilkChat (Flutter Web) на Apache / REG.RU, корень поддомена milk.lozhka.fun.
# Влияет только на папку этого сайта — lozhka.fun и app.lozhka.fun не затрагивает.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Всегда HTTPS (сертификат Let's Encrypt выпускается в ISPmanager).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

</IfModule>

# Приложение живёт на одном адресе (/), внутренние экраны адрес не меняют.
# Поэтому всё, чего нет на сервере, — настоящая 404 со своей страницей.
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType font/otf .otf
  AddType font/ttf .ttf
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Картинки, шрифты и движок кэшируем на неделю. Код приложения, index.html,
  # загрузчик и списки ассетов/шрифтов — нет: правило ниже должно идти после
  # общего, иначе после обновления сайта браузер неделю держит старую версию
  # (со старым FontManifest.json новый шрифт не подхватывается).
  <FilesMatch "\.(js|wasm|ttf|otf|png|jpg|svg|json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index\.html|404\.html|main\.dart\.(js|mjs|wasm)|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json|manifest\.json|FontManifest\.json|AssetManifest(\.bin)?(\.json)?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Нужно для всплывающего окна входа через Google.
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
